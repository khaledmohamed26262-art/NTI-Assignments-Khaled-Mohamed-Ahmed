#include <stdio.h>

#define MAX_ARRAY_SIZE 100

int main(void)
{
    signed int arraySize = 0;
    signed int index = 0;
    unsigned char evenElementCount = 0U;
    unsigned char oddElementCount = 0U;

    printf("Enter size of the array: ");

    if (scanf("%d", &arraySize) != 1 ||
        arraySize <= 0 ||
        arraySize > MAX_ARRAY_SIZE)
    {
        printf("Invalid array size!\n");
        return 1;
    }

    signed int arrayElements[arraySize];

    printf("Enter %d elements in array:\n", arraySize);

    for (index = 0; index < arraySize; index++)
    {
        if (scanf("%d", &arrayElements[index]) != 1)
        {
            printf("Invalid array element!\n");
            return 1;
        }

        if (arrayElements[index] % 2 == 0)
        {
            evenElementCount++;
        }
        else
        {
            oddElementCount++;
        }
    }

    printf("Total even elements: %hhu\n", evenElementCount);
    printf("Total odd elements: %hhu\n", oddElementCount);

    return 0;
}