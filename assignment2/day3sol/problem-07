#include <stdio.h>

#define MAX_ARRAY_SIZE 100

int main(void)
{
    signed int arraySize = 0;
    signed int index = 0;
    signed int deletionPosition = 0;

    printf("Enter number of elements in array\n");

    if (scanf("%d", &arraySize) != 1 ||
        arraySize <= 0 ||
        arraySize > MAX_ARRAY_SIZE)
    {
        printf("Invalid array size!\n");
        return 1;
    }

    signed int arrayElements[arraySize];

    printf("Enter %d elements\n", arraySize);

    for (index = 0; index < arraySize; index++)
    {
        if (scanf("%d", &arrayElements[index]) != 1)
        {
            printf("Invalid array element!\n");
            return 1;
        }
    }

    printf("Enter the location where you wish to delete element\n");

    if (scanf("%d", &deletionPosition) != 1 ||
        deletionPosition < 1 ||
        deletionPosition > arraySize)
    {
        printf("Deletion is not possible!\n");
        return 1;
    }

    for (index = deletionPosition - 1;
         index < arraySize - 1;
         index++)
    {
        arrayElements[index] = arrayElements[index + 1];
    }

    arraySize--;

    printf("Resultant array is\n");

    for (index = 0; index < arraySize; index++)
    {
        printf("%d\n", arrayElements[index]);
    }

    return 0;
}