#include <stdio.h>

#define MAX_ARRAY_SIZE 100

int main(void)
{
    signed int arraySize = 0;
    signed int index = 0;
    unsigned char negativeElementFound = 0U;

    printf("Enter size of the array : ");

    if (scanf("%d", &arraySize) != 1 ||
        arraySize <= 0 ||
        arraySize > MAX_ARRAY_SIZE)
    {
        printf("Invalid array size!\n");
        return 1;
    }

    signed int arrayElements[arraySize];

    printf("Enter elements in array :\n");

    for (index = 0; index < arraySize; index++)
    {
        if (scanf("%d", &arrayElements[index]) != 1)
        {
            printf("Invalid array element!\n");
            return 1;
        }
    }

    printf("\nAll negative elements in array are : ");

    for (index = 0; index < arraySize; index++)
    {
        if (arrayElements[index] < 0)
        {
            printf("%d ", arrayElements[index]);
            negativeElementFound = 1U;
        }
    }

    if (negativeElementFound == 0U)
    {
        printf("None");
    }

    printf("\n");

    return 0;
}