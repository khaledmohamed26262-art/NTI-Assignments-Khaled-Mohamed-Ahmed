#include <stdio.h>

#define ARRAY_SIZE 10

int main(void)
{
    signed int arrayElements[ARRAY_SIZE] = {0};
    signed int index = 0;
    signed int rotation = 0;
    signed int rotationCount = 0;
    signed int firstElement = 0;

    printf("Enter 10 elements array: ");

    for (index = 0; index < ARRAY_SIZE; index++)
    {
        if (scanf("%d", &arrayElements[index]) != 1)
        {
            printf("Invalid array element!\n");
            return 1;
        }
    }

    printf("Enter number of times to left rotate: ");

    if (scanf("%d", &rotationCount) != 1 || rotationCount < 0)
    {
        printf("Invalid rotation number!\n");
        return 1;
    }

    printf("Array before rotation: ");

    for (index = 0; index < ARRAY_SIZE; index++)
    {
        printf("%d ", arrayElements[index]);
    }

    rotationCount %= ARRAY_SIZE;

    for (rotation = 0; rotation < rotationCount; rotation++)
    {
        firstElement = arrayElements[0];

        for (index = 0; index < ARRAY_SIZE - 1; index++)
        {
            arrayElements[index] = arrayElements[index + 1];
        }

        arrayElements[ARRAY_SIZE - 1] = firstElement;
    }

    printf("\n\nArray after rotation\n");

    for (index = 0; index < ARRAY_SIZE; index++)
    {
        printf("%d ", arrayElements[index]);
    }

    printf("\n");

    return 0;
}